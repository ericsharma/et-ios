#!/bin/sh
# One-time headless signing setup (no GUI, login keychain untouched):
# a dedicated keychain with a random password, a development certificate
# created through the App Store Connect API, and Apple's WWDR intermediate.
# Re-running is safe; it does nothing if the keychain already exists.
set -eu
. "$(dirname "$0")/asc.env"
DIR="$HOME/.appstoreconnect"
KC="$HOME/Library/Keychains/et-signing.keychain-db"
PASS_FILE="$DIR/et-signing.pass"

if [ -f "$KC" ]; then echo "Signing keychain exists: $KC"; exit 0; fi

umask 077
openssl rand -hex 24 > "$PASS_FILE"
PASS=$(cat "$PASS_FILE")
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Key + CSR; Apple returns the signed certificate.
openssl genrsa -out "$WORK/key.pem" 2048 2>/dev/null
openssl req -new -key "$WORK/key.pem" -subj "/CN=E.T. mac-mini signing/O=Eric Sharma" -out "$WORK/csr.pem"
CSR=$(sed '/-----/d' "$WORK/csr.pem" | tr -d '\n')
TOKEN=$("$(dirname "$0")/asc-token")
curl -sf -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
  https://api.appstoreconnect.apple.com/v1/certificates \
  -d "{\"data\":{\"type\":\"certificates\",\"attributes\":{\"certificateType\":\"DEVELOPMENT\",\"csrContent\":\"$CSR\"}}}" \
  > "$WORK/cert.json"
python3 -c "import json,sys,base64; d=json.load(open(sys.argv[1])); open(sys.argv[2],'wb').write(base64.b64decode(d['data']['attributes']['certificateContent'])); print('Certificate:', d['data']['attributes']['name'], d['data']['id'])" "$WORK/cert.json" "$WORK/cert.cer"

openssl x509 -inform der -in "$WORK/cert.cer" -out "$WORK/cert.pem"
openssl pkcs12 -export -legacy -inkey "$WORK/key.pem" -in "$WORK/cert.pem" -out "$WORK/id.p12" -passout "pass:$PASS"

security create-keychain -p "$PASS" "$KC"
security set-keychain-settings "$KC"   # no auto-lock timeout
security unlock-keychain -p "$PASS" "$KC"
security import "$WORK/id.p12" -k "$KC" -P "$PASS" -T /usr/bin/codesign -T /usr/bin/security
security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$PASS" "$KC" >/dev/null
curl -sf -o "$WORK/wwdr.cer" https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer
security import "$WORK/wwdr.cer" -k "$KC" >/dev/null || true

# Add to the user's keychain search list, keeping the existing entries.
EXISTING=$(security list-keychains -d user | sed 's/^ *"//; s/"$//')
# shellcheck disable=SC2086
security list-keychains -d user -s "$KC" $EXISTING
echo "Done. Identities:"
security find-identity -v -p codesigning "$KC"
