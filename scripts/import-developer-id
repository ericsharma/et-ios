#!/bin/sh
# Imports the Developer ID Application certificate (the .cer from
# developer.apple.com, made from ~/.appstoreconnect/devid's CSR) with its
# private key into the signing keychain that scripts/setup-signing made.
#   scripts/import-developer-id ~/Downloads/developerID_application.cer
set -eu
CER=$1
DIR="$HOME/.appstoreconnect"
KC="$HOME/Library/Keychains/et-signing.keychain-db"
PASS=$(cat "$DIR/et-signing.pass")
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
openssl x509 -inform der -in "$CER" -out "$WORK/cert.pem" 2>/dev/null || cp "$CER" "$WORK/cert.pem"
# The certificate must belong to this key.
[ "$(openssl x509 -in "$WORK/cert.pem" -noout -pubkey)" = "$(openssl rsa -in "$DIR/devid/key.pem" -pubout 2>/dev/null)" ] \
  || { echo "This certificate wasn't made from ~/.appstoreconnect/devid's request." >&2; exit 1; }
openssl pkcs12 -export -legacy -inkey "$DIR/devid/key.pem" -in "$WORK/cert.pem" -out "$WORK/id.p12" -passout "pass:$PASS"
security unlock-keychain -p "$PASS" "$KC"
security import "$WORK/id.p12" -k "$KC" -P "$PASS" -T /usr/bin/codesign -T /usr/bin/security
security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$PASS" "$KC" >/dev/null
# Developer ID's intermediate (G2).
curl -fsSL -o "$WORK/devid-g2.cer" https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer
security import "$WORK/devid-g2.cer" -k "$KC" >/dev/null 2>&1 || true
security find-identity -v -p codesigning "$KC"
