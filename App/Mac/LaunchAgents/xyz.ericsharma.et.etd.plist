<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- etd as E.T.'s login item (SMAppService.agent, docs/PLAN-macos.md §4.1).
     Never the manymux node: an app update must not restart it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>xyz.ericsharma.et.etd</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/etd</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>xyz.ericsharma.et.mac</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Keep manymux's machine list equal to the network's machines. -->
        <key>ETD_MANYMUX_HOSTS</key>
        <string>1</string>
        <!-- A plist can't name the home folder; etd expands "~/". -->
        <key>ETD_LOG_FILE</key>
        <string>~/Library/Logs/etd.log</string>
    </dict>
</dict>
</plist>
